# Postgres DSN (async driver). Used by SQLAlchemy.
DATABASE_URL=db-url-production

# Shared secret expected in the X-Analytics-Key header on /api/analytics/events.
# Must match ANALYTICS_API_KEY in the frontend's .env.local.
ANALYTICS_API_KEY=dev-key-change-in-production

# CORS — single "*" for anywhere for dev environment, or comma-separated/specific origins for production.
CORS_ORIGINS=*

# Debug mode (set to false in production).
DEBUG=false